<Window x:Class="RadioEmisoraRD.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sidebar="clr-namespace:RadioEmisoraRD.Controls.Sidebar"
        xmlns:hero="clr-namespace:RadioEmisoraRD.Controls.Hero"
        xmlns:player="clr-namespace:RadioEmisoraRD.Controls.Player"
        xmlns:dashboard="clr-namespace:RadioEmisoraRD.Controls.Dashboard"
        xmlns:toast="clr-namespace:RadioEmisoraRD.Controls.Toast"
        Title="RadioEmisora RD"
        Icon="Assets/RadioEmisoraRD.ico"
        Width="1200"
        Height="720"
        MinWidth="900"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="#080C19"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        KeyboardNavigation.TabNavigation="Cycle"
        AutomationProperties.Name="RadioEmisora RD">

    <Grid>

        <Grid Visibility="{Binding MainLayoutVisibility}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="330"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <sidebar:SidebarControl x:Name="Sidebar" Grid.Column="0"/>

            <ScrollViewer Grid.Column="1"
                          Margin="35"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">

                <StackPanel>

                    <hero:HeroControl MinHeight="260"/>

                    <player:PlayerControl MinHeight="245"
                                          Margin="0,25,0,0"/>

                    <Border CornerRadius="24"
                            Background="#0A1023"
                            Margin="0,25,0,0"
                            Padding="22"
                            MinHeight="120">

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="RadioEmisoraRD • WPF • MVVM • Inspirado en el proyecto original"
                                       Foreground="#7F8AAD"
                                       FontSize="14"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"/>

                            <UniformGrid Grid.Row="1"
                                         Columns="4"
                                         Margin="0,18,0,0">
                                <Button Content="↻ Actualizar"
                                        Height="48"
                                        Background="#0072E5"
                                        Style="{StaticResource PrimaryButton}"
                                        FontSize="14"
                                        Margin="5,0"
                                        ToolTip="Buscar una versión nueva del catálogo (Ctrl+R)"
                                        AutomationProperties.Name="Actualizar catálogo"
                                        Command="{Binding ActualizarCommand}"/>

                                <Button Content="{Binding TextoFavorito}"
                                        Height="48"
                                        Background="#6A35FF"
                                        Style="{StaticResource PrimaryButton}"
                                        FontSize="14"
                                        Margin="5,0"
                                        ToolTip="Agregar o quitar la emisora seleccionada de favoritos"
                                        AutomationProperties.Name="Alternar favorito"
                                        Command="{Binding FavoritoCommand}"/>

                                <Button Content="ⓘ Acerca de"
                                        Height="48"
                                        Background="#008899"
                                        Style="{StaticResource PrimaryButton}"
                                        FontSize="14"
                                        Margin="5,0"
                                        AutomationProperties.Name="Abrir Acerca de"
                                        Command="{Binding AcercaDeCommand}"/>

                                <Button Content="Salir"
                                        Height="48"
                                        Background="#C41535"
                                        Style="{StaticResource PrimaryButton}"
                                        FontSize="14"
                                        Margin="5,0"
                                        ToolTip="Cerrar la aplicación (Ctrl+Q)"
                                        AutomationProperties.Name="Salir"
                                        Command="{Binding SalirCommand}"/>
                            </UniformGrid>
                        </Grid>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Grid>

        <dashboard:DashboardControl x:Name="Dashboard"
                                    Visibility="{Binding DashboardVisibility}"/>

        <toast:ToastControl Visibility="{Binding ToastVisibility}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Margin="0,0,35,35"/>

    </Grid>
</Window>
