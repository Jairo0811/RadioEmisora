<Window x:Class="RadioEmisoraRD.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Acerca de"
        Width="440"
        SizeToContent="Height"
        MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#0C1223"
        Foreground="White"
        Icon="Assets/RadioEmisoraRD.ico"
        ShowInTaskbar="False"
        AutomationProperties.Name="Acerca de RadioEmisora RD">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Focusable="False">

        <StackPanel Margin="28,24">

            <Image Source="/Assets/itla.png"
                   Width="175"
                   Height="90"
                   Stretch="Uniform"
                   Margin="0,0,0,14"
                   AutomationProperties.Name="Logo del Instituto Tecnológico de Las Américas"/>

            <TextBlock Text="RadioEmisora RD"
                       FontSize="28"
                       FontWeight="Bold"
                       TextAlignment="Center"
                       Margin="0,0,0,4"/>

            <TextBlock x:Name="VersionText"
                       Text="Versión"
                       Foreground="#AAB4CD"
                       FontSize="14"
                       FontStyle="Italic"
                       TextAlignment="Center"
                       Margin="0,0,0,20"/>

            <TextBlock Text="Francis Jairo Matías Rosario"
                       FontSize="15"
                       FontWeight="SemiBold"
                       TextAlignment="Center"
                       Margin="0,0,0,18"/>

            <TextBlock Text="Diseño Centrado en el Usuario (SOF-010)"
                       FontSize="14"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       Margin="0,0,0,6"/>

            <TextBlock Text="Profesor: Juan Martínez López"
                       FontSize="14"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       Margin="0,0,0,6"/>

            <TextBlock Text="Instituto Tecnológico de Las Américas (ITLA) · 2018-C1"
                       Foreground="#AAB4CD"
                       FontSize="13"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       Margin="0,0,0,4"/>

            <TextBlock Text="Proyecto final original · Modernización WPF 2026"
                       Foreground="#AAB4CD"
                       FontSize="13"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       Margin="0,0,0,18"/>

            <Border Background="#121A30"
                    BorderBrush="#263253"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="14,10"
                    Margin="0,0,0,22">
                <TextBlock Foreground="#C0C8E0"
                           FontSize="12"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Text="Proyecto académico independiente desarrollado originalmente como trabajo final del ITLA. No es una aplicación oficial del Instituto Tecnológico de Las Américas (ITLA). Los nombres, logos y transmisiones de las emisoras pertenecen a sus respectivos titulares."/>
            </Border>

            <Button Content="Aceptar"
                    Width="170"
                    Height="45"
                    Background="#6A35FF"
                    FontSize="15"
                    Style="{StaticResource PrimaryButton}"
                    IsDefault="True"
                    IsCancel="True"
                    AutomationProperties.Name="Cerrar Acerca de"
                    Click="btnAceptar_Click"/>
        </StackPanel>
    </ScrollViewer>
</Window>
